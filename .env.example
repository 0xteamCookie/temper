# Layer 1 - secrets and environment-specific endpoints ONLY.
# Which models to use is policy: see config/providers.json (never put model lists here).
# Copy to .env and fill in. Blank providers are skipped. .env is git-ignored; never commit real keys.
# Then run:  node scripts/register-providers.mjs --check   (validate keys)
#            node scripts/register-providers.mjs           (discover + register with TrueForge)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TRUEFOUNDRY_GATEWAY_BASE_URL=
TRUEFOUNDRY_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Google Vertex AI (Gemini on Google Cloud; uses your Cloud credits) ---
# Auth: either run `gcloud auth login` (default) OR set a service-account JSON path.
VERTEX_PROJECT_ID=
# "global" (recommended) or a region such as us-central1
VERTEX_LOCATION=global
VERTEX_SERVICE_ACCOUNT_JSON=
