# Copy to .env and fill in. Blank providers are skipped.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TRUEFOUNDRY_GATEWAY_BASE_URL=
TRUEFOUNDRY_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Notes
# - Leave a provider blank to skip it. Keys are read by the provider registration step
#   and handed to TrueForge; they are never stored in VS Code settings.
# - .env is git-ignored. Never commit real keys.

# --- Google Vertex AI (Gemini on Google Cloud; uses your Cloud credits) ---
# Auth: either run `gcloud auth login` (default) OR set a service-account JSON path.
VERTEX_PROJECT_ID=
# "global" (recommended) or a region such as us-central1
VERTEX_LOCATION=global
# optional; default: google/gemini-3.5-flash,google/gemini-3.1-pro-preview
VERTEX_MODELS=
VERTEX_SERVICE_ACCOUNT_JSON=
